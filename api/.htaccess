RewriteRule ^planejamento/(\d+)/?$ apiPlanejamento.php?id=$1 [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^planejamento/?$ apiPlanejamento.php [QSA,L]


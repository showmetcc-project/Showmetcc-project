RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^comunidade-midias/(\d+)/?$ apiComunidadeMidia.php?id=$1 [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^comunidade-midias/?$ apiComunidadeMidia.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^eventos/(\d+)/?$ apiEventos.php?id=$1 [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^eventos/?$ apiEventos.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^favoritos/(\d+)/?$ apiFavoritos.php?id=$1 [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^favoritos/?$ apiFavoritos.php [QSA,L]


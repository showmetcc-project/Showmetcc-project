RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^sessoes/(\d+)/?$ apiSessoes.php?id=$1 [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^sessoes/?$ apiSessoes.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^usuarios/(\d+)/?$ apiUsuarios.php?id=$1 [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
